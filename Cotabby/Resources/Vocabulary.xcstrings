    "This item changed while you were editing. Reopen it to continue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item changed while you were editing. Reopen it to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑期间此条目已发生变化，请重新打开后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯期間此項目已變更，請重新開啟後繼續。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag wurde während der Bearbeitung geändert. Öffne ihn erneut, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément a changé pendant la modification. Rouvrez-le pour continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento cambió durante la edición. Vuelve a abrirlo para continuar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa voce è cambiata durante la modifica. Riaprila per continuare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item mudou durante a edição. Abra-o novamente para continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中にこの項目が変更されました。開き直して続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 중에 이 항목이 변경되었습니다. 다시 열어 계속하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта запись изменилась во время редактирования. Откройте её заново, чтобы продолжить."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादन के दौरान यह प्रविष्टि बदल गई। जारी रखने के लिए इसे फिर से खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Entri ini berubah saat Anda mengeditnya. Buka kembali untuk melanjutkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu girdi düzenleme sırasında değişti. Devam etmek için yeniden açın."
