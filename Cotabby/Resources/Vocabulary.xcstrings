    "Several Anki notes use this sense ID. Resolve duplicates in Anki.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم عدة ملاحظات Anki معرّف المعنى هذا. عالج التكرارات في Anki."
          }
        },
        "de": {
          "stringUnit": {
