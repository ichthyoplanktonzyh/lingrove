    "Adds a UTF-8 signature and protects cells that start with formula symbols.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف توقيع UTF-8 ويحمي الخلايا التي تبدأ برموز الصيغ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt eine UTF-8-Signatur hinzu und schützt Zellen, die mit Formelzeichen beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a UTF-8 signature and protects cells that start with formula symbols."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una firma UTF-8 y protege las celdas que empiezan con símbolos de fórmula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une signature UTF-8 et protège les cellules commençant par des symboles de formule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8 हस्ताक्षर जोड़ता है और सूत्र चिह्नों से शुरू होने वाले सेल सुरक्षित करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan tanda UTF-8 dan melindungi sel yang diawali simbol rumus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge una firma UTF-8 e protegge le celle che iniziano con simboli di formula."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8署名を追加し、数式記号で始まるセルを保護します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8 서명을 추가하고 수식 기호로 시작하는 셀을 보호합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma assinatura UTF-8 e protege células que começam com símbolos de fórmula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет сигнатуру UTF-8 и защищает ячейки, начинающиеся с символов формул."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8 imzası ekler ve formül simgeleriyle başlayan hücreleri korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 UTF-8 标记，并保护以公式符号开头的单元格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 UTF-8 標記，並保護以公式符號開頭的儲存格。"
          }
        }
      }
    },
    "An export image is missing. Restore it or export without images.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إحدى صور التصدير مفقودة. استعدها أو صدّر دون صور."
          }
        },
