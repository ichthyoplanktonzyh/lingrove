    "The selected senses changed. Reopen Export to refresh the selection.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت المعاني المحددة. أعد فتح التصدير لتحديث التحديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Bedeutungen wurden geändert. Öffne den Export erneut, um die Auswahl zu aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected senses changed. Reopen Export to refresh the selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acepciones seleccionadas cambiaron. Vuelve a abrir Exportar para actualizar la selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sens sélectionnés ont changé. Rouvrez l’exportation pour actualiser la sélection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित अर्थ बदल गए हैं। चयन ताज़ा करने के लिए निर्यात फिर खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makna yang dipilih telah berubah. Buka kembali Ekspor untuk memperbarui pilihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I significati selezionati sono cambiati. Riapri Esporta per aggiornare la selezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した語義が変更されました。書き出しを開き直して選択を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 의미가 변경되었습니다. 내보내기를 다시 열어 선택을 갱신하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sentidos selecionados mudaram. Reabra Exportar para atualizar a seleção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные значения изменились. Откройте экспорт заново, чтобы обновить выбор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen anlamlar değişti. Seçimi yenilemek için Dışa Aktar’ı yeniden açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选义项已变化，请重新打开导出以刷新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選義項已變更，請重新開啟匯出以重新整理選取範圍。"
          }
        }
      }
    },
    "This export is too large. Export a smaller selection.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التصدير كبير جدًا. صدّر مجموعة أصغر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Export ist zu groß. Exportiere eine kleinere Auswahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This export is too large. Export a smaller selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación es demasiado grande. Exporta una selección más pequeña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette exportation est trop volumineuse. Exportez une sélection plus petite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह निर्यात बहुत बड़ा है। छोटा चयन निर्यात करें।"
          }
        },
