    "Replace this notebook with the selected backup, including images and Anki associations.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用所选备份替换当前生词本，包括图片和 Anki 关联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以所選備份取代目前生詞本，包含圖片與 Anki 關聯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像とAnkiの関連付けを含め、選択したバックアップで単語帳を置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지와 Anki 연결을 포함하여 선택한 백업으로 단어장을 교체합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer ce carnet par la sauvegarde sélectionnée, avec les images et les liens Anki."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Wortschatz durch die gewählte Sicherung einschließlich Bildern und Anki-Verknüpfungen ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplazar este vocabulario por la copia seleccionada, incluidas las imágenes y las asociaciones de Anki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir este vocabulário pelo backup selecionado, incluindo imagens e vínculos do Anki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci questo vocabolario con il backup selezionato, incluse immagini e associazioni Anki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить словарь выбранной резервной копией, включая изображения и связи с Anki."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال دفتر المفردات بالنسخة الاحتياطية المحددة، بما يشمل الصور وروابط Anki."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्रों और Anki संबंधों सहित इस शब्दावली को चुने हुए बैकअप से बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti buku kosakata ini dengan cadangan yang dipilih, termasuk gambar dan tautan Anki."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sözcük defterini görseller ve Anki bağlantıları dahil seçilen yedekle değiştirin."
          }
        }
      }
    },
