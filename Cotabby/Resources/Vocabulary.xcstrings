          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение для экспорта отсутствует. Восстановите его или экспортируйте без изображений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
