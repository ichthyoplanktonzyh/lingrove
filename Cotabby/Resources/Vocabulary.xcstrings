            "value": "Gambar ekspor tidak ditemukan. Pulihkan atau ekspor tanpa gambar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca un’immagine da esportare. Ripristinala o esporta senza immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出す画像が見つかりません。復元するか、画像なしで書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낼 이미지가 없습니다. 복원하거나 이미지 없이 내보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
