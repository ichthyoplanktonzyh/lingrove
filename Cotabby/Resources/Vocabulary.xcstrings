    "Some selected senses have no cards. Add cards in the notebook first.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分所选义项尚无卡片，请先在生词本中添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分所選義項尚無卡片，請先在生詞本中新增。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した語義の一部にはカードがありません。先に単語帳で追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 일부 뜻에 카드가 없습니다. 먼저 단어장에서 카드를 추가하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige ausgewählte Bedeutungen haben keine Karten. Füge sie zuerst im Vokabelheft hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains sens sélectionnés n’ont pas de cartes. Ajoutez-en d’abord dans le carnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas acepciones seleccionadas no tienen tarjetas. Añádelas primero en el vocabulario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni significati selezionati non hanno schede. Aggiungile prima nel vocabolario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns sentidos selecionados não têm cartões. Adicione-os primeiro no caderno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У некоторых выбранных значений нет карточек. Сначала добавьте их в словарь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen bazı anlamların kartı yok. Önce sözcük defterinde kart ekleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa makna yang dipilih belum memiliki kartu. Tambahkan kartu di buku kosakata terlebih dahulu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ चुने गए अर्थों के कार्ड नहीं हैं। पहले शब्दावली में कार्ड जोड़ें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض المعاني المحددة لا تحتوي على بطاقات. أضف بطاقات في دفتر المفردات أولًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some selected senses have no cards. Add cards in the notebook first."
          }
        }
      }
    },
