        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक निर्यात चित्र गायब है। उसे पुनर्स्थापित करें या चित्रों के बिना निर्यात करें।"
          }
        },
        "id": {
          "stringUnit": {
