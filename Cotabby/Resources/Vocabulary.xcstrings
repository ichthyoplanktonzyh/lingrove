    "The Anki card template changed. Restore Front and Back before sending.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki 卡片模板已改变，请恢复 Front 和 Back 后再发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki 卡片範本已改變，請還原 Front 和 Back 後再傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki のカードテンプレートが変更されています。送信前に Front と Back を復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki 카드 템플릿이 변경되었습니다. 전송하기 전에 Front와 Back을 복원하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anki-Kartenvorlage wurde geändert. Stelle vor dem Senden Front und Back wieder her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Anki a changé. Rétablissez Front et Back avant l’envoi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La plantilla de Anki cambió. Restaura Front y Back antes de enviar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello Anki è cambiato. Ripristina Front e Back prima dell’invio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo Anki foi alterado. Restaure Front e Back antes de enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблон Anki изменён. Восстановите Front и Back перед отправкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki kart şablonu değişti. Göndermeden önce Front ve Back alanlarını geri yükleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat Anki berubah. Pulihkan Front dan Back sebelum mengirim."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki कार्ड टेम्पलेट बदल गया है। भेजने से पहले Front और Back बहाल करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغير قالب بطاقة Anki. استعد Front وBack قبل الإرسال."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Anki card template changed. Restore Front and Back before sending."
          }
        }
      }
    },
