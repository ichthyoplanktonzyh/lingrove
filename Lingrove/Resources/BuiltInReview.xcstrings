    "error.load": {
      "comment": "Native Mac built-in review. error.load",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read review data. Refresh to try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر قراءة بيانات المراجعة. حدّث لمحاولة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholungsdaten konnten nicht gelesen werden. Aktualisiere, um es erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los datos de práctica. Actualiza para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les données de révision. Actualisez pour réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराव का डेटा पढ़ा नहीं जा सका। फिर कोशिश करने के लिए रीफ़्रेश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data pengulangan tidak dapat dibaca. Segarkan untuk mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere i dati delle ripetizioni. Aggiorna per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復習データを読み込めませんでした。更新してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복습 데이터를 읽을 수 없습니다. 새로 고쳐 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
