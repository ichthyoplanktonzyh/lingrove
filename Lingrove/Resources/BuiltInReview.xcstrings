    "description.choose": {
      "comment": "Native Mac built-in review. description.choose",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a saved sense to inspect its material, then explicitly add it to review."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح معنى محفوظًا لمعاينة محتواه، ثم أضفه صراحةً إلى المراجعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine gespeicherte Bedeutung, um ihr Material anzusehen, und füge sie dann ausdrücklich zur Wiederholung hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una acepción guardada para consultar su material y añádela expresamente a la práctica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un sens enregistré pour consulter son contenu, puis ajoutez-le explicitement aux révisions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा हुआ अर्थ खोलकर उसकी सामग्री देखें, फिर उसे स्पष्ट रूप से दोहराव में जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka makna tersimpan untuk memeriksa materinya, lalu tambahkan secara eksplisit ke pengulangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un’accezione salvata per esaminarne il materiale, poi aggiungila esplicitamente alle ripetizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した語義を開いて教材を確認し、その後、復習に明示的に追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 의미를 열어 자료를 확인한 다음 복습에 명시적으로 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma acepção salva para conferir o material e, em seguida, adicione-a explicitamente à revisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте сохранённое значение, чтобы просмотреть его материал, а затем явно добавьте его к повторению."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Materyalini incelemek için kaydedilmiş bir anlamı açın, ardından onu açıkça tekrara ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
