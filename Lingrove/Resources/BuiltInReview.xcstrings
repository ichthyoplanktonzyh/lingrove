    "error.source": {
      "comment": "Native Mac built-in review. error.source",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original sense is no longer available. Existing exercises and history are kept."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد المعنى الأصلي متاحًا. تم الاحتفاظ بالبطاقات الحالية وسجلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche Bedeutung ist nicht mehr verfügbar. Vorhandene Übungskarten und ihr Verlauf bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acepción original ya no está disponible. Se conservan las tarjetas existentes y su historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sens d’origine n’est plus disponible. Les cartes existantes et leur historique sont conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल अर्थ अब उपलब्ध नहीं है। मौजूदा कार्ड और उनका इतिहास सुरक्षित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makna asli tidak lagi tersedia. Kartu yang ada dan riwayatnya tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accezione originale non è più disponibile. Le schede esistenti e la cronologia sono conservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の語義は利用できなくなりました。既存のカードと履歴は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 의미를 더 이상 사용할 수 없습니다. 기존 카드와 기록은 보존됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A acepção original não está mais disponível. Os cartões existentes e o histórico foram mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходное значение больше недоступно. Существующие карточки и история сохранены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özgün anlam artık kullanılamıyor. Mevcut kartlar ve geçmişleri korunuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原义项已不可用。现有练习卡和历史记录仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始義項已無法使用。現有練習卡和歷史紀錄會保留。"
          }
        }
      }
    },
