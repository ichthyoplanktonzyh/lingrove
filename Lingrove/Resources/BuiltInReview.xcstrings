    "session.scheduled": {
      "comment": "Native Mac built-in review. session.scheduled",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your memory progress is saved. Scheduled exercises will return when they are due."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ تقدمك في التذكر. ستعود البطاقات المجدولة عند حلول موعدها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Lernfortschritt ist gespeichert. Geplante Übungskarten kehren zurück, sobald sie fällig sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu progreso de memoria está guardado. Las tarjetas programadas volverán cuando toque repasarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre progression de mémorisation est enregistrée. Les cartes planifiées reviendront à leur échéance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "याददाश्त की प्रगति सहेजी गई है। समय-निर्धारित कार्ड बकाया होने पर फिर आएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemajuan ingatan Anda tersimpan. Kartu terjadwal akan kembali saat waktunya tiba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi progressi di memorizzazione sono salvati. Le schede programmate torneranno quando saranno in scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶の進捗を保存しました。予定されたカードは復習時期になると再び表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억 진행 상황을 저장했습니다. 일정이 잡힌 카드는 복습 시기가 되면 다시 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu progresso de memória foi salvo. Os cartões agendados voltarão quando chegar a hora da revisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс запоминания сохранён. Запланированные карточки вернутся, когда наступит срок повторения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafıza ilerlemeniz kaydedildi. Planlanmış kartlar zamanı geldiğinde tekrar gösterilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记忆进度已保存。已安排的练习卡会在到期时再次出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶進度已儲存。已排程的練習卡會在到期時再次出現。"
          }
        }
      }
    },
