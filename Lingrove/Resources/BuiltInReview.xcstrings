    "description.history": {
      "comment": "Native Mac built-in review. description.history",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rating records include undone ratings. Current exercise scheduling determines your progress."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتضمن سجلات التقييم التقييمات التي تم التراجع عنها. ويحدد جدول البطاقات الحالي تقدمك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewertungsverläufe enthalten auch rückgängig gemachte Bewertungen. Dein Fortschritt richtet sich nach der aktuellen Planung der Übungskarten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial incluye también las valoraciones deshechas. Tu progreso depende de la programación actual de cada tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique comprend les notes annulées. Votre progression dépend de la planification actuelle de chaque carte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेटिंग रिकॉर्ड में पूर्ववत की गई रेटिंग भी शामिल हैं। आपकी प्रगति हर कार्ड के मौजूदा समय-निर्धारण से तय होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan penilaian mencakup penilaian yang diurungkan. Kemajuan Anda ditentukan oleh jadwal kartu saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia include anche le valutazioni annullate. I tuoi progressi dipendono dalla programmazione attuale delle schede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価記録には取り消した評価も含まれます。進捗は各カードの現在の予定によって決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평가 기록에는 취소된 평가도 포함됩니다. 진행 상황은 각 카드의 현재 일정에 따라 결정됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros incluem avaliações desfeitas. Seu progresso depende do agendamento atual de cada cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В истории оценок есть и отменённые оценки. Ваш прогресс определяется текущим расписанием карточек."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerlendirme kayıtlarında geri alınan değerlendirmeler de bulunur. İlerlemeniz kartların mevcut programına göre belirlenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评分记录也包括已撤销的评分。当前练习卡的复习安排决定你的进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "評分紀錄也包含已復原的評分。每張練習卡目前的排程會決定你的進度。"
          }
        }
      }
    },
    "description.offline": {
      "comment": "Native Mac built-in review. description.offline",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
