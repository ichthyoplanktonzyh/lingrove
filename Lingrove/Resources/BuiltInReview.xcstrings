    "keyboard.hint": {
      "comment": "Native Mac built-in review. keyboard.hint",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space or Return shows the answer · 1–4 rates after reveal · ⌘Z undoes a rating"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض Space أو Return الإجابة · يقيّم 1–4 بعد إظهارها · يلغي ⌘Z آخر تقييم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leertaste oder Return zeigt die Antwort · 1–4 bewerten nach dem Aufdecken · ⌘Z macht eine Bewertung rückgängig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio o Return muestra la respuesta · 1–4 para calificar después de mostrarla · ⌘Z deshace una valoración"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace ou Return affiche la réponse · 1–4 notent après l’affichage · ⌘Z annule une note"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्तर दिखाने के लिए Space या Return · दिखाने के बाद रेटिंग देने के लिए 1–4 · रेटिंग पूर्ववत करने के लिए ⌘Z"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Space atau Return menampilkan jawaban · 1–4 memberi nilai setelah jawaban ditampilkan · ⌘Z mengurungkan penilaian"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio o Return mostra la risposta · 1–4 valutano dopo averla mostrata · ⌘Z annulla una valutazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SpaceまたはReturnで答えを表示 · 表示後に1–4で評価 · ⌘Zで評価を取り消し"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Space 또는 Return을 누르면 정답 표시 · 표시 후 1–4로 평가 · ⌘Z로 평가 취소"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço ou Return mostra a resposta · 1–4 avaliam após a revelação · ⌘Z desfaz uma avaliação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробел или Return показывает ответ · 1–4 оценивают после показа · ⌘Z отменяет оценку"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtı göstermek için Space veya Return · Gösterdikten sonra puanlamak için 1–4 · Değerlendirmeyi geri almak için ⌘Z"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Space 或 Return 显示答案 · 显示后按 1–4 评分 · 按 ⌘Z 撤销评分"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Space 或 Return 顯示答案 · 顯示後按 1–4 評分 · 按 ⌘Z 復原評分"
          }
        }
      }
    },
