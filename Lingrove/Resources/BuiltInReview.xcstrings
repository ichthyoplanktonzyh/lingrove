    "material.retained": {
      "comment": "Native Mac built-in review. material.retained",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using saved material. The original source is unavailable."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام المحتوى المحفوظ. المصدر الأصلي غير متاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichertes Material wird verwendet. Die ursprüngliche Quelle ist nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa el material guardado. La fuente original no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu enregistré utilisé. La source d’origine n’est pas disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी गई सामग्री इस्तेमाल हो रही है। मूल स्रोत उपलब्ध नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan materi tersimpan. Sumber asli tidak tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in uso il materiale salvato. La fonte originale non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した教材を使用中です。元の出典は利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 자료를 사용 중입니다. 원래 출처를 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usando o material salvo. A fonte original não está disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется сохранённый материал. Исходный источник недоступен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş materyal kullanılıyor. Özgün kaynak kullanılamıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用已保存的材料。原始来源不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用已儲存的教材。原始來源無法使用。"
          }
        }
      }
    },
    "material.unavailable": {
      "comment": "Native Mac built-in review. material.unavailable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source material is unavailable. This exercise is excluded until you choose new context or use saved material."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مادة المصدر غير متاحة. تُستبعد هذه البطاقة إلى أن تختار سياقًا جديدًا أو تستخدم المحتوى المحفوظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quellmaterial ist nicht verfügbar. Diese Übungskarte ist ausgeschlossen, bis du einen neuen Kontext auswählst oder gespeichertes Material verwendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El material de la fuente no está disponible. Esta tarjeta queda excluida hasta que elijas un contexto nuevo o uses el material guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu source est indisponible. Cette carte est exclue jusqu’à ce que vous choisissiez un nouveau contexte ou utilisiez le contenu enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्रोत सामग्री उपलब्ध नहीं है। नया संदर्भ चुनने या सहेजी गई सामग्री इस्तेमाल करने तक यह कार्ड शामिल नहीं होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Materi sumber tidak tersedia. Kartu ini tidak disertakan sampai Anda memilih konteks baru atau menggunakan materi tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il materiale originale non è disponibile. Questa scheda è esclusa finché non scegli un nuovo contesto o usi il materiale salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出典の教材を利用できません。新しい文脈を選ぶか保存した教材を使うまで、このカードは対象外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출처 자료를 사용할 수 없습니다. 새 문맥을 선택하거나 저장된 자료를 사용할 때까지 이 카드는 제외됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O material da fonte não está disponível. Este cartão fica excluído até você escolher um novo contexto ou usar o material salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный материал недоступен. Карточка исключена, пока вы не выберете новый контекст или не используете сохранённый материал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak materyal kullanılamıyor. Yeni bir bağlam seçene veya kaydedilmiş materyali kullanana kadar bu kart tekrara alınmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源材料不可用。选择新语境或使用已保存材料之前，此练习卡不会参与复习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源教材無法使用。選擇新語境或使用已儲存教材之前，此練習卡不會列入複習。"
          }
        }
      }
    },
    "message.changed": {
      "comment": "Native Mac built-in review. message.changed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review data or the active account changed. Unsaved material and the current question were closed. Please review the refreshed data."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت بيانات المراجعة أو الحساب النشط. أُغلقت المواد غير المحفوظة والسؤال الحالي. يُرجى مراجعة البيانات المحدّثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederholungsdaten oder das aktive Konto haben sich geändert. Nicht gespeichertes Material und die aktuelle Frage wurden geschlossen. Bitte prüfe die aktualisierten Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Han cambiado los datos de práctica o la cuenta activa. Se cerraron el material sin guardar y la pregunta actual. Revisa los datos actualizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de révision ou le compte actif ont changé. Le contenu non enregistré et la question en cours ont été fermés. Veuillez consulter les données actualisées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराव का डेटा या सक्रिय खाता बदल गया। बिना सहेजी सामग्री और मौजूदा प्रश्न बंद कर दिए गए। कृपया ताज़ा डेटा जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data pengulangan atau akun aktif berubah. Materi yang belum disimpan dan pertanyaan saat ini ditutup. Periksa data yang telah diperbarui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati delle ripetizioni o l’account attivo sono cambiati. Il materiale non salvato e la domanda corrente sono stati chiusi. Controlla i dati aggiornati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復習データまたはアクティブなアカウントが変更されました。未保存の教材と現在の問題を閉じました。更新されたデータを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복습 데이터 또는 활성 계정이 변경되었습니다. 저장하지 않은 자료와 현재 질문을 닫았습니다. 새로 고친 데이터를 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados da revisão ou a conta ativa mudaram. O material não salvo e a pergunta atual foram fechados. Confira os dados atualizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные повторения или активная учётная запись изменились. Несохранённый материал и текущий вопрос закрыты. Проверьте обновлённые данные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar verileri veya etkin hesap değişti. Kaydedilmemiş materyal ve mevcut soru kapatıldı. Lütfen yenilenen verileri kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复习数据或当前账户已更改。未保存的材料和当前问题已关闭。请检查已刷新的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複習資料或目前帳號已變更。未儲存的教材和目前問題已關閉。請檢查更新後的資料。"
          }
        }
      }
    },
