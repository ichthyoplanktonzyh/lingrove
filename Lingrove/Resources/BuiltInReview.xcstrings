          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать данные повторения. Обновите и попробуйте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar verileri okunamadı. Yenileyip tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取复习数据。请刷新后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取複習資料。請重新整理後再試一次。"
          }
        }
      }
    },
    "error.source": {
      "comment": "Native Mac built-in review. error.source",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original sense is no longer available. Existing exercises and history are kept."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد المعنى الأصلي متاحًا. تم الاحتفاظ بالبطاقات الحالية وسجلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche Bedeutung ist nicht mehr verfügbar. Vorhandene Übungskarten und ihr Verlauf bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acepción original ya no está disponible. Se conservan las tarjetas existentes y su historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sens d’origine n’est plus disponible. Les cartes existantes et leur historique sont conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल अर्थ अब उपलब्ध नहीं है। मौजूदा कार्ड और उनका इतिहास सुरक्षित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makna asli tidak lagi tersedia. Kartu yang ada dan riwayatnya tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accezione originale non è più disponibile. Le schede esistenti e la cronologia sono conservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の語義は利用できなくなりました。既存のカードと履歴は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 의미를 더 이상 사용할 수 없습니다. 기존 카드와 기록은 보존됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A acepção original não está mais disponível. Os cartões existentes e o histórico foram mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходное значение больше недоступно. Существующие карточки и история сохранены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özgün anlam artık kullanılamıyor. Mevcut kartlar ve geçmişleri korunuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原义项已不可用。现有练习卡和历史记录仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始義項已無法使用。現有練習卡和歷史紀錄會保留。"
          }
        }
      }
    },
    "error.write": {
      "comment": "Native Mac built-in review. error.write",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action could not be saved. The latest data has been reloaded; please check it before trying again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ هذا الإجراء. أعيد تحميل أحدث البيانات؛ يُرجى مراجعتها قبل المحاولة مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion konnte nicht gespeichert werden. Die neuesten Daten wurden neu geladen; prüfe sie bitte, bevor du es erneut versuchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar esta acción. Se han vuelto a cargar los datos más recientes; revísalos antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action n’a pas pu être enregistrée. Les données les plus récentes ont été rechargées ; vérifiez-les avant de réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्रवाई सहेजी नहीं जा सकी। नवीनतम डेटा फिर से लोड किया गया है; दोबारा कोशिश करने से पहले कृपया उसे जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini tidak dapat disimpan. Data terbaru telah dimuat ulang; periksa sebelum mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare questa azione. I dati più recenti sono stati ricaricati; controllali prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作を保存できませんでした。最新のデータを再読み込みしました。もう一度試す前に内容を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 저장하지 못했습니다. 최신 데이터를 다시 불러왔습니다. 다시 시도하기 전에 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar esta ação. Os dados mais recentes foram carregados novamente; confira-os antes de tentar outra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить это действие. Последние данные загружены заново; проверьте их перед новой попыткой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem kaydedilemedi. En güncel veriler yeniden yüklendi; tekrar denemeden önce lütfen kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存此操作。已重新加载最新数据；请先检查，再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存此操作。已重新載入最新資料；請先檢查，再重試。"
          }
        }
      }
    },
