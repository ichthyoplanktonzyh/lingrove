        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A revisão integrada não está disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенное повторение недоступно."
          }
        },
