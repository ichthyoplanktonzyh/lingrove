    "state.reviewUnavailable": {
      "comment": "Notebook workspace navigation and availability. state.reviewUnavailable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in review is unavailable."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المراجعة المدمجة غير متاحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die integrierte Wiederholung ist nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repaso integrado no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La révision intégrée est indisponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतर्निहित दोहराव उपलब्ध नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulasan bawaan tidak tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripasso integrato non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵の復習機能は利用できません。"
