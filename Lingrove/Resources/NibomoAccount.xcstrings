    "settings.account.server.confirmationMessage": {
      "comment": "Selected Nibomo AISettings copy (MIT); native Mac locale adaptation. See MAC_W3_UI_REUSE_MAP.md.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم قطع اتصال هذا الجهاز بالخادم الحالي. تظل البيانات المحلية موجودة على هذا الجهاز، ولن تبدأ المزامنة تلقائيًا وسيتعين عليك تسجيل الدخول مرة أخرى يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wird vom aktuellen Server getrennt. Lokale Daten verbleiben auf diesem Gerät, die Synchronisierung startet nicht automatisch und Sie müssen sich erneut manuell anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device will disconnect from the current cloud server. Local data stays on this device, sync will not start automatically, and you will need to sign in again manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo se desconectara del servidor actual. Los datos locales permanecen en este dispositivo, la sincronizacion no se iniciara automaticamente y tendras que iniciar sesion de nuevo manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil sera déconnecté du serveur cloud actuel. Les données locales restent sur cet appareil, la synchronisation ne démarrera pas automatiquement, et vous devrez vous reconnecter manuellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस वर्तमान सर्वर से डिस्कनेक्ट हो जाएगा. स्थानीय डेटा इस डिवाइस पर रहता है, सिंक्रोनाइज़ेशन स्वचालित रूप से प्रारंभ नहीं होगा और आपको मैन्युअल रूप से फिर से लॉग इन करना होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini akan terputus dari server cloud saat ini. Data lokal tetap di perangkat, sinkronisasi tidak dimulai otomatis, dan Anda perlu masuk lagi secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo si disconnetterà dal server cloud attuale. I dati locali rimarranno sul dispositivo, la sincronizzazione non partirà automaticamente e dovrai accedere di nuovo manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは現在のサーバーから切断されます。ローカル データはこのデバイスに残ります。同期は自動的に開始されないため、手動で再度ログインする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 현재 클라우드 서버에서 연결 해제됩니다. 로컬 데이터는 기기에 유지되고 동기화는 자동으로 시작되지 않으며 직접 다시 로그인해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo vai se desconectar do servidor de nuvem atual. Os dados locais continuam no dispositivo, a sincronização não começa automaticamente e você vai precisar entrar de novo manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство будет отключено от текущего сервера. Локальные данные остаются на этом устройстве, синхронизация не запустится автоматически, и вам придется снова войти в систему вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıt mevcut bulut sunucusundan ayrılır. Yerel veriler bu aygıtta kalır, eşzamanlama otomatik başlamaz ve yeniden elle giriş yapmanız gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备将与当前服务器断开连接。本地数据保留在此设备上，同步不会自动开始，您必须手动重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置將與目前的雲端伺服器中斷連線。本機資料會留在此裝置上，同步不會自動開始，你需要手動重新登入。"
          }
        }
      },
      "extractionState": "manual"
    },
    "settings.account.server.confirmationTitle.apply": {
