    "settings.account.cloudSignIn.challengePrompt.active": {
      "comment": "Selected Nibomo AISettings copy (MIT); native Mac locale adaptation. See MAC_W3_UI_REUSE_MAP.md.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرمز المكوّن من 8 أرقام الذي وصلك عبر البريد الإلكتروني. إذا لم تجده، فتحقق من مجلد الرسائل غير المرغوب فيها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie den 8-stelligen Code ein, den Sie per E-Mail erhalten haben. Wenn Sie ihn nicht sehen, prüfen Sie den Spam-Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 8-digit code from your email. If you don't see it, check your spam folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el codigo de 8 digitos que recibiste por correo. Si no lo ves, revisa la carpeta de spam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code à 8 chiffres reçu par e-mail. Si vous ne le voyez pas, vérifiez votre dossier de spam."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको ईमेल द्वारा प्राप्त 8-अंकीय कोड दर्ज करें। अगर यह न दिखे, तो स्पैम फ़ोल्डर देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kode 8 digit dari email Anda. Jika tidak terlihat, periksa folder spam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice di 8 cifre ricevuto via email. Se non lo vedi, controlla la cartella spam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールで受け取った 8 桁のコードを入力してください。見つからない場合は、迷惑メールフォルダを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일로 받은 8자리 코드를 입력하세요. 보이지 않으면 스팸함을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código de 8 dígitos que enviamos por e-mail. Se não encontrar, verifique a caixa de spam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите 8-значный код, который вы получили по электронной почте. Если его нет, проверьте папку «Спам»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postanızdaki 8 haneli kodu girin. Göremiyorsanız spam klasörünü kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入您通过电子邮件收到的 8 位代码。如果没有看到，请检查垃圾邮件文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入電子郵件中的 8 位數驗證碼。如果沒有看到，請檢查垃圾郵件資料夾。"
          }
        }
      },
      "extractionState": "manual"
    },
    "settings.account.cloudSignIn.challengePrompt.expired": {
      "comment": "Selected Nibomo AISettings copy (MIT); native Mac locale adaptation. See MAC_W3_UI_REUSE_MAP.md.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد انتهت صلاحية هذا الرمز. اطلب واحدة جديدة للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist abgelaufen. Fordern Sie ein neues an, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code expired. Request a new code to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este codigo ha caducado. Solicita uno nuevo para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code a expiré. Demandez un nouveau code pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड समाप्त हो गया है. जारी रखने के लिए एक नए का अनुरोध करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode ini kedaluwarsa. Minta kode baru untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice è scaduto. Richiedi un nuovo codice per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードの有効期限は切れています。続行するには、新しいリクエストをリクエストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료된 코드입니다. 계속하려면 새 코드를 요청하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código expirou. Solicite um novo código para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия этого кода истек. Чтобы продолжить, запросите новый."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kodun süresi doldu. Devam etmek için yeni bir kod isteyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该代码已过期。请求新的继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證碼已過期。請索取新的驗證碼以繼續。"
          }
        }
      },
      "extractionState": "manual"
    },
