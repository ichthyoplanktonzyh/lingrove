    "scope.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in reviews in the current notebook. Undone ratings are excluded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前词本的内置复习统计，不计入已撤销的评分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前詞本的內建複習統計，不計入已撤銷的評分。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrierte Wiederholungen im aktuellen Notizbuch. Rückgängig gemachte Bewertungen zählen nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repasos integrados del cuaderno actual. Se excluyen las valoraciones deshechas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révisions intégrées du carnet actuel. Les évaluations annulées sont exclues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान नोटबुक की अंतर्निहित समीक्षाएँ। वापस ली गई रेटिंग शामिल नहीं हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulasan bawaan di buku catatan saat ini. Penilaian yang dibatalkan tidak dihitung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripassi integrati del quaderno attuale. Le valutazioni annullate sono escluse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のノートの内蔵復習の統計です。取り消した評価は含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 노트의 내장 복습 통계입니다. 실행 취소한 평가는 제외됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisões integradas do caderno atual. Avaliações desfeitas são excluídas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенные повторения в текущей тетради. Отменённые оценки не учитываются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli defterin yerleşik tekrarları. Geri alınan puanlar dahil edilmez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المراجعات المدمجة في دفتر الملاحظات الحالي. تُستبعد التقييمات التي تم التراجع عنها."
          }
        }
      }
    },
