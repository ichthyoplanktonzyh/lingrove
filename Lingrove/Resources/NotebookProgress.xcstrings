{
  "sourceLanguage": "en",
  "strings": {
    "empty.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a sense for built-in review, then complete a review to begin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确将义项选入内置复习并完成一次复习后，即可查看进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明確將義項選入內建複習並完成一次複習後，即可查看進度。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Bedeutung für die integrierte Wiederholung und schließe eine Wiederholung ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una acepción para el repaso integrado y completa un repaso para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un sens pour la révision intégrée, puis terminez une révision pour commencer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए किसी अर्थ को अंतर्निहित समीक्षा में चुनें और एक समीक्षा पूरी करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih makna untuk ulasan bawaan, lalu selesaikan satu ulasan untuk memulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un significato per il ripasso integrato e completa un ripasso per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語義を内蔵の復習に登録し、復習を完了すると進捗が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뜻을 내장 복습에 등록하고 복습을 완료하면 진행 상황이 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma acepção para a revisão integrada e conclua uma revisão para começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите значение для встроенного повторения и завершите повторение, чтобы начать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için yerleşik tekrara bir anlam seçin ve bir tekrarı tamamlayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر معنى للمراجعة المدمجة ثم أكمل مراجعة للبدء."
          }
        }
      }
    },
    "empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No review history yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无复习记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無複習記錄"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Wiederholungsverlauf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay historial de repasos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun historique de révision"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी समीक्षा इतिहास नहीं है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada riwayat ulasan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna cronologia di ripasso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復習履歴はまだありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 복습 기록이 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há histórico de revisões"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истории повторений пока нет"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz tekrar geçmişi yok"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد سجل مراجعة بعد"
          }
        }
      }
    },
    "error.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved reviews are unchanged. Try loading again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的复习记录未改变。请重新加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的複習記錄未變更。請重新載入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Wiederholungen bleiben unverändert. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus repasos guardados no han cambiado. Intenta cargarlos de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos révisions enregistrées sont inchangées. Réessayez le chargement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सहेजी गई समीक्षाएँ नहीं बदली हैं। फिर से लोड करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulasan tersimpan tidak berubah. Coba muat lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I ripassi salvati non sono cambiati. Prova a ricaricare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの復習記録は変更されていません。再度読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 복습 기록은 변경되지 않았습니다. 다시 불러오세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas revisões salvas não foram alteradas. Tente carregar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые повторения не изменены. Попробуйте загрузить снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı tekrarlarınız değişmedi. Yeniden yüklemeyi deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتغير مراجعاتك المحفوظة. حاول التحميل مجددًا."
          }
        }
      }
    },
