    "Signing in only confirms your identity. Choose a workspace, decide what to do with local material, then enable sync.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول يؤكد هويتك فقط. اختر مساحة عمل، وحدد ما تريد فعله بموادك المحلية، ثم فعّل المزامنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung bestätigt nur deine Identität. Wähle einen Arbeitsbereich, entscheide, was mit deinen lokalen Materialien geschehen soll, und aktiviere anschließend die Synchronisierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in only confirms your identity. Choose a workspace, decide what to do with local material, then enable sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión solo confirma tu identidad. Elige un espacio de trabajo, decide qué hacer con el material local y activa la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion confirme uniquement votre identité. Choisissez un espace de travail, décidez quoi faire de votre contenu local, puis activez la synchronisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करने से केवल आपकी पहचान की पुष्टि होती है। कोई कार्यक्षेत्र चुनें, तय करें कि स्थानीय सामग्री के साथ क्या करना है, फिर सिंक चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk hanya mengonfirmasi identitas Anda. Pilih ruang kerja, tentukan tindakan untuk materi lokal, lalu aktifkan sinkronisasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso conferma solo la tua identità. Scegli uno spazio di lavoro, decidi cosa fare con il materiale locale, poi attiva la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインで確認されるのは本人確認のみです。ワークスペースを選び、ローカルの素材をどうするか決めてから、同期を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인은 신원 확인만 수행합니다. 워크스페이스를 선택하고 로컬 자료를 어떻게 처리할지 정한 다음 동기화를 활성화하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sessão apenas confirma sua identidade. Escolha um espaço de trabalho, decida o que fazer com o material local e então ative a sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход подтверждает только вашу личность. Выберите рабочее пространство, решите, что делать с локальными материалами, затем включите синхронизацию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açmak yalnızca kimliğinizi doğrular. Bir çalışma alanı seçin, yerel materyallerinizle ne yapacağınıza karar verin, ardından eşitlemeyi etkinleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录仅用于确认您的身份。请选择一个工作区，决定如何处理本地资料，然后启用同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入僅用於確認您的身分。請選擇一個工作區，決定如何處理本機資料，然後啟用同步。"
          }
        }
      }
    },
