          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta la libreria locale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルライブラリを取り込む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 라이브러리 가져오기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceitar a biblioteca local"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять локальную библиотеку"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel kitaplığı kabul et"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收本地资料库"
          }
        },
        "zh-Hant": {
