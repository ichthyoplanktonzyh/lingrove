    "Enter valid API and authentication base URLs. Use HTTPS, or HTTP on loopback for local testing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عنوانَي URL أساسيين صالحين لواجهة API والمصادقة. استخدم HTTPS، أو HTTP على عنوان loopback للاختبار المحلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie gültige Basis-URLs für API und Authentifizierung ein. Verwenden Sie HTTPS oder für lokale Tests HTTP über die Loopback-Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter valid API and authentication base URLs. Use HTTPS, or HTTP on loopback for local testing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce URL base válidas para la API y la autenticación. Usa HTTPS o HTTP en una dirección de loopback para pruebas locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez des URL de base valides pour l’API et l’authentification. Utilisez HTTPS, ou HTTP sur une adresse de bouclage pour les tests locaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API और प्रमाणीकरण के मान्य बेस URL दर्ज करें। HTTPS का उपयोग करें; स्थानीय परीक्षण के लिए loopback पर HTTP का उपयोग किया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan URL dasar API dan autentikasi yang valid. Gunakan HTTPS, atau HTTP pada loopback untuk pengujian lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci URL di base validi per l’API e l’autenticazione. Usa HTTPS o HTTP su loopback per i test locali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な API と認証のベース URL を入力してください。HTTPS を使用してください。ローカルテストではループバック上の HTTP を使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 API 및 인증 기본 URL을 입력하세요. HTTPS를 사용하세요. 로컬 테스트에서는 루프백 주소에 HTTP를 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite URLs base válidas para API e autenticação. Use HTTPS ou HTTP em loopback para testes locais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите действительные базовые URL API и аутентификации. Используйте HTTPS или HTTP через loopback для локального тестирования."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API ve kimlik doğrulama için geçerli temel URL'leri girin. HTTPS kullanın; yerel testlerde loopback adresinde HTTP kullanılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的 API 和身份验证基础 URL。请使用 HTTPS；本地测试可使用回环地址上的 HTTP。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入有效的 API 和驗證服務基底 URL。請使用 HTTPS；本機測試可使用迴送位址上的 HTTP。"
          }
        }
      }
    },
