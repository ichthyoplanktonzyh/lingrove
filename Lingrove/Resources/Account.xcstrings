    "Your saved session is not confirmed online. Local writing and learning remain available.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تأكيد جلستك المحفوظة عبر الإنترنت. يمكنك مواصلة الكتابة والتعلّم محليًا."
          }
        },
        "de": {
          "stringUnit": {
