            "value": "Ihre gespeicherte Sitzung wurde online nicht bestätigt. Sie können weiterhin lokal schreiben und lernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved session is not confirmed online. Local writing and learning remain available."
          }
        },
        "es": {
