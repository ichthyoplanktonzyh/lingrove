          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açmayı iptal et"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消登录"
          }
        },
        "zh-Hant": {
