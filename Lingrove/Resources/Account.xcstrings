    "Signing in confirms your identity only. Your local library stays on this Mac; account sync is not connected.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤكد تسجيل الدخول هويتك فقط. تظل مكتبتك المحلية على هذا الـ Mac؛ ولم تتم تهيئة مزامنة الحساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung bestätigt nur Ihre Identität. Ihre lokale Bibliothek bleibt auf diesem Mac; die Kontosynchronisierung ist nicht verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in confirms your identity only. Your local library stays on this Mac; account sync is not connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión solo confirma tu identidad. Tu biblioteca local permanece en este Mac; la sincronización de la cuenta no está conectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion sert uniquement à confirmer votre identité. Votre bibliothèque locale reste sur ce Mac ; la synchronisation du compte n’est pas activée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करने से केवल आपकी पहचान की पुष्टि होती है। आपकी स्थानीय लाइब्रेरी इस Mac पर ही रहती है; खाते का सिंक कनेक्ट नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk hanya mengonfirmasi identitas Anda. Pustaka lokal Anda tetap ada di Mac ini; sinkronisasi akun belum terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso serve solo a confermare la tua identità. La libreria locale resta su questo Mac; la sincronizzazione dell’account non è attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインでは本人確認のみを行います。ローカルライブラリはこの Mac に保存されたままで、アカウント同期には接続されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인은 신원 확인만 합니다. 로컬 라이브러리는 이 Mac에 그대로 유지되며 계정 동기화는 연결되어 있지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login confirma apenas sua identidade. Sua biblioteca local permanece neste Mac; a sincronização da conta não está conectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход подтверждает только вашу личность. Локальная библиотека остается на этом Mac; синхронизация учетной записи не подключена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açma yalnızca kimliğinizi doğrular. Yerel kitaplığınız bu Mac'te kalır; hesap eşzamanlaması bağlı değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录仅用于确认您的身份。您的本地资料库仍保留在此 Mac 上；账户同步尚未接入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入只會確認您的身分。您的本機資料庫仍留在此 Mac；尚未連接帳戶同步。"
          }
        }
      }
    },
    "The account operation was cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغيت عملية الحساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontovorgang wurde abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account operation was cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló la operación de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération sur le compte a été annulée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते की कार्रवाई रद्द कर दी गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi akun dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’operazione dell’account è stata annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント操作はキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 작업이 취소되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação da conta foi cancelada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция с учетной записью отменена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap işlemi iptal edildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户操作已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶操作已取消。"
          }
        }
      }
    },
    "The account service could not be reached. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاتصال بخدمة الحساب. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontodienst ist nicht erreichbar. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account service could not be reached. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servicio de cuenta. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le service de compte. Vérifiez votre connexion, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता सेवा से संपर्क नहीं हो सका। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan akun tidak dapat dijangkau. Periksa koneksi Anda, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il servizio account. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントサービスに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 서비스에 연결할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o serviço de conta. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с сервисом учетной записи. Проверьте подключение и попробуйте еще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap hizmetine ulaşılamadı. Bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到账户服务。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至帳戶服務。請檢查網路連線後再試。"
          }
        }
      }
    },
    "The account service is temporarily unavailable. Try again later.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة الحساب غير متاحة مؤقتًا. حاول مرة أخرى لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontodienst ist vorübergehend nicht verfügbar. Versuchen Sie es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account service is temporarily unavailable. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de cuenta no está disponible temporalmente. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de compte est temporairement indisponible. Réessayez plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता सेवा अभी उपलब्ध नहीं है। बाद में फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan akun sementara tidak tersedia. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio account è temporaneamente non disponibile. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントサービスは一時的に利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 서비스를 일시적으로 사용할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de conta está temporariamente indisponível. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис учетной записи временно недоступен. Попробуйте позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap hizmeti geçici olarak kullanılamıyor. Daha sonra yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务暂时不可用。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶服務暫時無法使用。請稍後再試。"
          }
        }
      }
    },
    "The account service returned an unexpected response. Check the connection settings and retry.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعادت خدمة الحساب استجابة غير متوقعة. تحقّق من إعدادات الاتصال وأعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontodienst hat eine unerwartete Antwort zurückgegeben. Überprüfen Sie die Verbindungseinstellungen und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account service returned an unexpected response. Check the connection settings and retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de cuenta devolvió una respuesta inesperada. Comprueba la configuración de conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de compte a renvoyé une réponse inattendue. Vérifiez les réglages de connexion, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता सेवा से अनपेक्षित जवाब मिला। कनेक्शन सेटिंग जाँचें और फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan akun memberikan respons yang tidak terduga. Periksa pengaturan koneksi, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio account ha restituito una risposta imprevista. Controlla le impostazioni di connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントサービスから予期しない応答がありました。接続設定を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 서비스에서 예상하지 못한 응답을 받았습니다. 연결 설정을 확인하고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de conta retornou uma resposta inesperada. Verifique as configurações de conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис учетной записи вернул неожиданный ответ. Проверьте настройки подключения и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap hizmeti beklenmeyen bir yanıt verdi. Bağlantı ayarlarını kontrol edip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户服务返回了意外响应。请检查连接设置后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶服務傳回非預期的回應。請檢查連線設定後重試。"
          }
        }
      }
    },
    "The private Keychain could not be accessed. Retry when it is available. Local sign-out will not restore this session.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى سلسلة المفاتيح الخاصة. أعد المحاولة عندما تصبح متاحة. لن يؤدي تسجيل الخروج محليًا إلى استعادة هذه الجلسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den privaten Schlüsselbund konnte nicht zugegriffen werden. Versuchen Sie es erneut, sobald er verfügbar ist. Durch die lokale Abmeldung wird diese Sitzung nicht wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private Keychain could not be accessed. Retry when it is available. Local sign-out will not restore this session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder al llavero privado. Vuelve a intentarlo cuando esté disponible. Cerrar la sesión localmente no restaurará esta sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’accéder au trousseau privé. Réessayez lorsqu’il est disponible. La déconnexion locale ne restaurera pas cette session."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निजी Keychain तक पहुँच नहीं हो सकी। उपलब्ध होने पर फिर कोशिश करें। स्थानीय रूप से साइन आउट करने से यह सेशन बहाल नहीं होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain pribadi tidak dapat diakses. Coba lagi saat sudah tersedia. Keluar secara lokal tidak akan memulihkan sesi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile accedere al Portachiavi privato. Riprova quando è disponibile. L’uscita locale non ripristina questa sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベート Keychain にアクセスできませんでした。利用可能になってからもう一度お試しください。この Mac からサインアウトしても、このセッションは復元されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 키체인에 접근할 수 없습니다. 사용할 수 있을 때 다시 시도하세요. 로컬 로그아웃으로는 이 세션을 복원할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o chaveiro privado. Tente novamente quando estiver disponível. Sair localmente não restaurará esta sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить доступ к закрытой связке ключей. Повторите попытку, когда она станет доступна. Выход из учетной записи на этом Mac не восстановит этот сеанс."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel Anahtar Zinciri'ne erişilemedi. Kullanılabilir olduğunda yeniden deneyin. Yerel olarak oturumu kapatmak bu oturumu geri yüklemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问私有钥匙串。请在钥匙串可用时重试。本地退出登录不会恢复此会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取私密鑰匙圈。請等鑰匙圈可用時再試。本機登出不會還原此工作階段。"
          }
        }
      }
    },
    "The service returned a different account. Sign in again to confirm your identity.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعادت الخدمة حسابًا مختلفًا. سجّل الدخول مرة أخرى لتأكيد هويتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst hat ein anderes Konto zurückgegeben. Melden Sie sich erneut an, um Ihre Identität zu bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service returned a different account. Sign in again to confirm your identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio devolvió una cuenta distinta. Vuelve a iniciar sesión para confirmar tu identidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service a renvoyé un autre compte. Reconnectez-vous pour confirmer votre identité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेवा ने अलग खाता लौटाया। अपनी पहचान की पुष्टि के लिए फिर से साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan mengembalikan akun yang berbeda. Masuk lagi untuk mengonfirmasi identitas Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio ha restituito un account diverso. Accedi di nuovo per confermare la tua identità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスから別のアカウントが返されました。本人確認のため、もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스에서 다른 계정을 반환했습니다. 신원을 확인하려면 다시 로그인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço retornou uma conta diferente. Entre novamente para confirmar sua identidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис вернул другую учетную запись. Войдите снова, чтобы подтвердить личность."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizmet farklı bir hesap döndürdü. Kimliğinizi doğrulamak için tekrar oturum açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回了不同的账户。请重新登录以确认您的身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務傳回了不同的帳戶。請重新登入以確認您的身分。"
          }
        }
      }
    },
    "This clears this Mac's session. It does not delete your account or sign out other devices.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى مسح الجلسة من هذا الـ Mac. لن يحذف حسابك أو يسجّل خروج الأجهزة الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die Sitzung auf diesem Mac gelöscht. Ihr Konto wird nicht gelöscht und andere Geräte werden nicht abgemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears this Mac's session. It does not delete your account or sign out other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra la sesión de este Mac. No elimina tu cuenta ni cierra la sesión en otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela efface la session de ce Mac. Votre compte ne sera pas supprimé et les autres appareils ne seront pas déconnectés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इस Mac का सेशन मिट जाएगा। आपका खाता नहीं हटेगा और दूसरे डिवाइस से साइन आउट नहीं होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini menghapus sesi dari Mac ini. Akun Anda tidak dihapus dan perangkat lain tidak dikeluarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione cancella la sessione da questo Mac. Non elimina l’account né disconnette gli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac のセッションを消去します。アカウントは削除されず、ほかのデバイスからもサインアウトしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 세션이 지워집니다. 계정이 삭제되거나 다른 기기에서 로그아웃되지는 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga a sessão deste Mac. Sua conta não será excluída e os outros dispositivos não sairão da conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс на этом Mac будет удален. Учетная запись не удаляется, на других устройствах выход не выполняется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem bu Mac'teki oturumu siler. Hesabınızı silmez ve diğer cihazlardaki oturumları kapatmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会清除此 Mac 上的会话。不会删除您的账户，也不会让其他设备退出登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會清除此 Mac 的工作階段。它不會刪除您的帳戶，也不會讓其他裝置登出。"
          }
        }
      }
    },
    "This code has already been used. Request a new code.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استُخدم هذا الرمز من قبل. اطلب رمزًا جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code wurde bereits verwendet. Fordern Sie einen neuen Code an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code has already been used. Request a new code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código ya se usó. Solicita uno nuevo."
