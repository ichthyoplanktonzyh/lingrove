    },
    "Too many incorrect attempts. Request a new code and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد المحاولات الخاطئة كبير جدًا. اطلب رمزًا جديدًا ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele falsche Versuche. Fordern Sie einen neuen Code an und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many incorrect attempts. Request a new code and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiados intentos incorrectos. Solicita un código nuevo e inténtalo otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives incorrectes. Demandez un nouveau code et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत बार गलत कोशिश की गई। नया कोड माँगें और फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak upaya yang salah. Minta kode baru dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi errati. Richiedi un nuovo codice e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ミスが多すぎます。新しいコードをリクエストして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 시도가 너무 많습니다. 새 코드를 요청한 다음 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas incorretas. Solicite um novo código e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много неверных попыток. Запросите новый код и попробуйте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla yanlış deneme yapıldı. Yeni bir kod isteyin ve yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误次数过多。请请求新验证码后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錯誤嘗試次數過多。請要求新驗證碼後再試。"
          }
        }
      }
    },
    "Too many requests. Wait a moment and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد الطلبات كبير جدًا. انتظر قليلًا ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anfragen. Warten Sie einen Moment und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Wait a moment and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiadas solicitudes. Espera un momento e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de demandes. Patientez un instant, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत अधिक अनुरोध किए गए। थोड़ी देर रुकें और फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak permintaan. Tunggu sebentar, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe richieste. Attendi un momento e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます。少し待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 너무 많습니다. 잠시 기다렸다가 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas solicitações. Aguarde um instante e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов. Подождите немного и попробуйте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla istek yapıldı. Biraz bekleyip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过于频繁。请稍等片刻后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求次數過多。請稍候片刻再試。"
          }
        }
      }
    },
