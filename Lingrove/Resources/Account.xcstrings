          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सहेजे गए सेशन की ऑनलाइन पुष्टि नहीं हुई है। आप स्थानीय रूप से लिखना और सीखना जारी रख सकते हैं।"
