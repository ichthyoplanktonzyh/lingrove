  "main": "index.js",
  "scripts": {
    "studio": "remotion studio src/film-entry.ts",
    "render:first-hello": "remotion render src/film-entry.ts Lingrove-FirstHello out/lingrove-first-hello-1080p.mp4 --scale=1.5 --image-format=png --codec=h264 --crf=14",
    "render:first-hello:en": "remotion render src/film-entry.ts Lingrove-FirstHello-English out/lingrove-first-hello-en-1080p.mp4 --scale=1.5 --image-format=png --codec=h264 --crf=14",
    "render:film": "remotion render src/film-entry.ts Lingrove-NextTime out/lingrove-next-time-1080p.mp4 --scale=1.5 --image-format=png --codec=h264 --crf=14",
    "check": "tsc --noEmit --jsx react --esModuleInterop --lib dom,es2022 --moduleResolution bundler --module esnext --skipLibCheck src/film-entry.ts src/opening-entry.ts src/story-entry.ts src/director-entry.ts src/lookup-entry.ts src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
